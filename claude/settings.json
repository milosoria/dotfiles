{
  "skillListingBudgetFraction": 0.03,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/session-files"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "WebSearch",
      "WebFetch",
      "Bash(playwright-cli:*)",
      "Bash(curl:*)",
      "Bash(xargs:*)",
      "Bash(find:*)",
      "Bash(pnpm:*)",
      "Bash(mkdir:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(gcloud secrets versions access:*)",
      "Bash(gcloud run services list:*)",
      "Bash(gh secret:*)",
      "Bash(python3:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(git log:*)",
      "Bash(npx tsc:*)",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "Bash(git push:*)",
      "Bash(~/.claude/scripts/nvim-open.sh:*)"
    ],
    "deny": [],
    "ask": [
      "Read(.env.production)",
      "Bash(*env.production*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "cli": "off",
    "find-skills": "off",
    "go": "off",
    "improve-codebase-architecture": "off",
    "tdd": "off",
    "to-issues": "off",
    "to-prd": "off",
    "gitnexus-cli": "off",
    "gitnexus-debugging": "off",
    "gitnexus-exploring": "off",
    "gitnexus-guide": "off",
    "gitnexus-impact-analysis": "off",
    "gitnexus-pr-review": "off",
    "gitnexus-refactoring": "off",
    "grill-me": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const i=JSON.parse(d);const cmd=(i.tool_input&&i.tool_input.command)||'';if(cmd.indexOf('read-replica/run.sh')!==-1){process.stdout.write(JSON.stringify({hookSpecificOutput:{hookEventName:'PreToolUse',permissionDecision:'allow',permissionDecisionReason:'Sanctioned read-replica skill (reads .env.production internally, no secret leak)'}}))}}catch(e){}})\"",
            "statusMessage": "Auto-approving read-replica skill..."
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Enriching with GitNexus graph context..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "find \"$PROJECT_DIR\" -name 'CLAUDE.md' -mtime +14 2>/dev/null | while read f; do days=$(( ( $(date +%s) - $(stat -f %m \"$f\") ) / 86400 )); echo \"[Hook] STALE (${days}d): $f\"; done",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/tmux/claude-window-state.sh\" idle",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$TMUX\" ] && tmux set-option -p -t \"$TMUX_PANE\" @claude-session \"$(jq -r .session_id)\"; true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$TMUX\" ]; then tmux set-window-option -t \"$TMUX_PANE\" automatic-rename on; tmux set-option -pu -t \"$TMUX_PANE\" @claude-name; tmux set-option -pu -t \"$TMUX_PANE\" @claude-title; tmux set-option -pu -t \"$TMUX_PANE\" @claude-state; tmux set-option -pu -t \"$TMUX_PANE\" @claude-session; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/kitty-notify.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.config/tmux/claude-window-state.sh\" wait",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/kitty-notify.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.config/tmux/claude-window-state.sh\" notify",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/gitnexus/gitnexus-hook.cjs\"",
            "timeout": 10,
            "statusMessage": "Checking GitNexus index freshness..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/tmux/claude-window-state.sh\" busy",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/tmux/claude-window-state.sh\" idle",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/kitty-notify.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/tmux/claude-window-state.sh\" busy",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); dir=$(basename \"$(echo \"$input\" | jq -r '.workspace.current_dir')\"); remaining=$(echo \"$input\" | jq -r '.context_window.remaining_percentage // empty'); branch=$(cd \"$(echo \"$input\" | jq -r '.workspace.current_dir')\" 2>/dev/null && git -c core.fileMode=false rev-parse --abbrev-ref HEAD 2>/dev/null || echo ''); effort=$(echo \"$input\" | jq -r '.effort.level // empty'); printf \"\\033[96m%s\\033[0m \\033[90m|\\033[0m \\033[95m%s\\033[0m\" \"$model\" \"$dir\"; [ -n \"$branch\" ] && printf \" \\033[90m|\\033[0m \\033[93m%s\\033[0m\" \"$branch\"; [ -n \"$effort\" ] && printf \" \\033[90m|\\033[0m \\033[36meffort: %s\\033[0m\" \"$effort\"; if [ -n \"$remaining\" ]; then r=$(printf \"%.0f\" \"$remaining\"); if [ \"$r\" -gt 50 ]; then c=\"\\033[92m\"; elif [ \"$r\" -gt 25 ]; then c=\"\\033[93m\"; else c=\"\\033[91m\"; fi; printf \" \\033[90m|\\033[0m ${c}ctx: %s%%\\033[0m\" \"$r\"; fi; echo"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "hookify@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": false,
    "macal-toolkit@macal": true,
    "claude-md-management@claude-plugins-official": true,
    "vercel@claude-plugins-official": false,
    "taste-skill@taste-skill": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "macal": {
      "source": {
        "source": "github",
        "repo": "MacalMaia/macal-claude-toolkit"
      },
      "autoUpdate": true
    },
    "taste-skill": {
      "source": {
        "source": "github",
        "repo": "Leonxlnx/taste-skill"
      }
    }
  },
  "language": "Español",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-2": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:gruvbox-material",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "kitty",
  "switchModelsOnFlag": false,
  "teammateMode": "tmux",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "mcpServers": {
    "docker": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run"
      ],
      "type": "stdio"
    }
  }
}
